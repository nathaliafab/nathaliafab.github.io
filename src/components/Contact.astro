---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../data/types';
import { profile } from '../data/profile';
import { t } from '../i18n/ui';
import Section from './Section.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

const items = [
  { key: 'email', label: profile.email, href: `mailto:${profile.email}`, icon: 'lucide:mail' },
  { key: 'linkedin', label: 'linkedin.com/in/nathaliafab', href: profile.links.linkedin, icon: 'fa6-brands:linkedin-in' },
  { key: 'github', label: 'github.com/nathaliafab', href: profile.links.github, icon: 'fa6-brands:github' },
] as const;
---

<Section id="contact" title={ui.sections.contact}>
  <p class="note">{ui.contactText}</p>
  <ul class="contact-list">
    {
      items.map((i) => (
        <li>
          <a href={i.href} data-contact-open={i.key === 'email' ? '' : undefined} rel={i.key === 'email' ? undefined : 'noopener'} target={i.key === 'email' ? undefined : '_blank'}>
            <Icon name={i.icon} aria-hidden="true" />
            <span class="contact-kind">{ui.social[i.key]}</span>
            <span class="contact-label">{i.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
