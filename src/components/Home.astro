---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../data/types';
import { profile } from '../data/profile';
import { projects, projectName } from '../data/projects';
import { papers, awards } from '../data/papers';
import { events } from '../data/events';
import { t, formatMonth, localePath } from '../i18n/ui';
import { getPosts } from '../i18n/blog';
import Section from './Section.astro';
import SocialLinks from './SocialLinks.astro';
import StackGrid from './StackGrid.astro';
import ProjectCard from './ProjectCard.astro';
import Contact from './Contact.astro';
import GitHubActivity from './GitHubActivity.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

const posts = (await getPosts()).slice(0, 3);
const allTags = [...new Set(projects.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' }));
const related = (e: (typeof events)[number]) => projects.find((p) => p.id === e.project);
const relatedPaper = (e: (typeof events)[number]) => papers.find((p) => p.id === e.paper);
const sortedEvents = [...events].sort((a, b) => b.date.localeCompare(a.date));
---

<div class="container">
  <section class="hero" aria-labelledby="hero-name">
    <div class="battle-field">
      <div class="plate plate-foe">
        <h1 id="hero-name">{profile.name}</h1>
        <p class="hero-role">{profile.role[lang]}</p>
        <div class="hp" aria-hidden="true"><span>HP</span><span class="hp-bar"><i></i></span></div>
      </div>
      <picture class="sprite-wrap foe"><source media="(prefers-reduced-motion: reduce)" srcset="/pokemon/caterpie.png" /><img class="sprite foe" src="/pokemon/caterpie.gif" alt="" width="56" height="56" /></picture>
      <picture class="sprite-wrap ally"><source media="(prefers-reduced-motion: reduce)" srcset="/pokemon/vileplume.png" /><img class="sprite ally" src="/pokemon/vileplume.gif" alt="" width="56" height="56" /></picture>
      <div class="plate plate-ally">
        <SocialLinks lang={lang} />
      </div>
    </div>
    <div class="battle-bottom">
      <div class="box dialog"><p>{profile.tagline[lang].split(' · ').map((line) => <span class="line">{line}</span>)}</p>
        <p class="place"><Icon name="lucide:map-pin" aria-hidden="true" /> {profile.location[lang]}</p>
      </div>
      <div class="box battle-menu">
        <a href={`${localePath('/', lang)}#about`}>{ui.nav.about}</a>
        <a href={`${localePath('/', lang)}#projects`}>{ui.cta.projects}</a>
        <a href={`${localePath('/', lang)}#contact`}>{ui.cta.contact}</a>
      </div>
    </div>
  </section>

  <Section id="about" title={ui.sections.about}>
    <div class="card about-card">
      <div class="about-side">
        <img class="avatar" src={profile.avatar} alt="" width="144" height="144" loading="lazy" referrerpolicy="no-referrer" />
        <picture class="sprite-wrap side"><source media="(prefers-reduced-motion: reduce)" srcset="/pokemon/hoppip.png" /><img class="sprite side" src="/pokemon/hoppip.gif" alt="" width="56" height="56" /></picture>
      </div>
      <div class="prose">
        {profile.about[lang].map((p) => <p>{p}</p>)}
      </div>
    </div>
  </Section>

  <Section id="projects" title={ui.sections.projects}>
    <div class="rail-wrap">
      <div class="rail-nav">
        <label class="rail-search">
          <Icon name="lucide:search" aria-hidden="true" />
          <input type="search" id="projects-search" placeholder={ui.searchProjects} aria-label={ui.searchProjects} autocomplete="off" />
        </label>
        <select id="projects-tag" class="rail-select" aria-label={ui.filterTag}>
          <option value="">{ui.allTags}</option>
          {allTags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
        <button type="button" class="pill icon-only" data-rail="-1" aria-label={ui.railPrev}><Icon name="lucide:chevron-left" aria-hidden="true" /></button>
        <button type="button" class="pill icon-only" data-rail="1" aria-label={ui.railNext}><Icon name="lucide:chevron-right" aria-hidden="true" /></button>
      </div>
      <div class="rail" id="projects-rail" tabindex="0" aria-label={ui.sections.projects}>
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
      <p class="rail-empty" id="projects-empty" hidden>{ui.noProjects}</p>
    </div>
    <GitHubActivity lang={lang} />
  </Section>

  <Section id="stack" title={ui.sections.stack}>
    <StackGrid lang={lang} />
  </Section>

  <Section id="papers" title={ui.sections.papers}>
    {
      papers.map((p) => (
        <article class="card paper">
          <h3>{p.title[lang]}</h3>
          <p class="paper-authors">
            {p.authors.map((a, i) => <Fragment>{i > 0 && ', '}{a === profile.name ? <strong>{a}</strong> : a}</Fragment>)}
          </p>
          <p class="muted">{p.venue[lang]} · {p.year}</p>
          {p.note && <p><span class="badge">{p.note[lang]}</span></p>}
          <p class="card-links">
            {p.links.paper && <a class="btn" href={p.links.paper} target="_blank" rel="noopener"><Icon name="lucide:file-text" aria-hidden="true" /> {ui.paper}</a>}
            {p.links.doi && <a class="btn" href={p.links.doi} target="_blank" rel="noopener"><Icon name="lucide:link" aria-hidden="true" /> {ui.paperDoi}</a>}
            {p.links.data && <a class="btn" href={p.links.data} target="_blank" rel="noopener"><Icon name="lucide:database" aria-hidden="true" /> {ui.paperData}</a>}
          </p>
        </article>
      ))
    }

    <h3 class="subtitle">{ui.sections.awards}</h3>
    <ul class="awards">
      {
        awards.map((a) => (
          <li>
            <Icon name="lucide:trophy" aria-hidden="true" />
            <span>
              <strong>{a.title[lang]}</strong>
              <span class="muted"> · {a.detail[lang]}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="events" title={ui.sections.events}>
    <ul class="events">
      {
        sortedEvents.map((e) => (
          <li class="event">
            <time class="event-date" datetime={e.date}>{formatMonth(e.date, lang)}</time>
            <div>
              <h3>{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.title[lang]}</a> : e.title[lang]}</h3>
              {(e.detail || e.place) && (
                <p class="muted">{[e.detail?.[lang], e.place?.[lang]].filter(Boolean).join(' · ')}</p>
              )}
              {relatedPaper(e)?.links.paper && (
                <p class="muted">
                  <Icon name="lucide:file-text" aria-hidden="true" /> <a href={relatedPaper(e)!.links.paper} target="_blank" rel="noopener">{relatedPaper(e)!.title[lang]}</a>
                </p>
              )}
              {related(e) && (
                <p class="muted">
                  <Icon name="lucide:folder-git-2" aria-hidden="true" /> <a href={`#project-${related(e)!.id}`}>{projectName(related(e)!, lang)}</a>
                </p>
              )}
            </div>
            <span class="badge">{ui.eventTypes[e.type]}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    posts.length > 0 && (
      <Section id="blog" title={ui.sections.blog}>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              <p class="muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
        <p><a class="btn" href="/blog">{ui.blog.allPosts}</a></p>
      </Section>
    )
  }

  <Contact lang={lang} />
</div>

<script>
  // Setas do carrossel de projetos: rolam um "cartão e meio" por clique
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const rail = document.getElementById('projects-rail');
      if (!rail) return;
      const dir = Number(btn.dataset.rail);
      const max = rail.scrollWidth - rail.clientWidth;
      // No fim volta ao começo, e no começo vai para o fim
      if (dir > 0 && rail.scrollLeft >= max - 24) rail.scrollTo({ left: 0, behavior: 'smooth' });
      else if (dir < 0 && rail.scrollLeft <= 24) rail.scrollTo({ left: max, behavior: 'smooth' });
      else rail.scrollBy({ left: dir * rail.clientWidth * 0.8, behavior: 'smooth' });
    });
  });

  // Busca por nome e filtro por tag: escondem os cartões que não batem
  (() => {
    const rail = document.getElementById('projects-rail');
    const search = document.getElementById('projects-search') as HTMLInputElement | null;
    const tagSel = document.getElementById('projects-tag') as HTMLSelectElement | null;
    const empty = document.getElementById('projects-empty');
    if (!rail || !search || !tagSel) return;
    const norm = (v: string) => v.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const cards = [...rail.querySelectorAll<HTMLElement>('.card.project')];
    const apply = () => {
      const q = norm(search.value);
      const tag = tagSel.value;
      let shown = 0;
      cards.forEach((card) => {
        const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
        const ok = (!q || norm(card.dataset.name ?? '').includes(q)) && (!tag || tags.includes(tag));
        card.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      rail.scrollTo({ left: 0 });
    };
    search.addEventListener('input', apply);
    tagSel.addEventListener('change', apply);
  })();
</script>
