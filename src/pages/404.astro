---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const lang = 'en';
const ui = t(lang);
---

<Base lang={lang} title={ui.notFound.title}>
  <div class="container">
    <h1 class="page-title">{ui.notFound.title}</h1>
    <div class="card center">
      <p>{ui.notFound.text}</p>
      <p><a class="btn primary" href="/">{ui.notFound.home}</a></p>
    </div>
  </div>
</Base>
