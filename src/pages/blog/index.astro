---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../i18n/blog';
import { t } from '../../i18n/ui';

const lang = 'en';
const ui = t(lang);
const posts = await getPosts();
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<Base lang={lang} title={ui.blog.title} path="/blog">
  <div class="container">
    <h1 class="page-title">{ui.blog.title}</h1>
    {
      posts.length === 0 ? (
        <p>{ui.blog.empty}</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              <p class="muted"><time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time> · {post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
